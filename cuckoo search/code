import numpy as np
import math

# 1. Define resource allocation problem
resources = np.array([100, 120, 80])

demand = np.array([
    [60, 50, 30],
    [50, 70, 40],
    [40, 60, 50],
    [70, 40, 60]
])

nests = 20
pa = 0.25
iterations = 100
beta = 1.5

# 2. Fitness function
def fitness(x):
    return np.sum(np.log1p(np.sum(x, axis=1)))

# 3. Check resource constraints
def repair(x):
    x = np.clip(x, 0, demand)

    for j in range(len(resources)):
        total = np.sum(x[:, j])
        if total > resources[j]:
            x[:, j] *= resources[j] / total

    return x

# 4. Initialize nests
population = np.array([
    repair(np.random.uniform(0, demand))
    for _ in range(nests)
])

best = population[0].copy()

# 5. Cuckoo Search
for _ in range(iterations):

    for i in range(nests):

        # Levy flight
        u = np.random.normal(0, 1)
        v = np.random.normal(0, 1)
        step = u / (abs(v) ** (1 / beta) + 1e-10)

        new = repair(
            population[i] + 0.5 * step *
            (population[i] - best)
        )

        j = np.random.randint(nests)

        if fitness(new) > fitness(population[j]):
            population[j] = new

    # Abandon worst nests
    scores = np.array([fitness(x) for x in population])
    worst = np.argsort(scores)[:int(pa * nests)]

    for i in worst:
        population[i] = repair(np.random.uniform(0, demand))

    # Update best solution
    scores = np.array([fitness(x) for x in population])
    best = population[np.argmax(scores)].copy()

# 6. Display final result only
print("\nOPTIMAL RESOURCE ALLOCATION")

for i, allocation in enumerate(best):
    print(f"Project {i+1}: {np.round(allocation, 2)}")

print("\nMaximum Fitness:", round(fitness(best), 4))

